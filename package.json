{
  "name": "rea-ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm build:wasm && pnpm --filter @rea/web dev",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:mac": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "design:app": "node scripts/build-app-design.mjs",
    "reaui": "node packages/reaui-cli/bin/reaui.mjs",
    "build:cli": "pnpm --filter @xtcel/reaui-cli build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "pnpm build:wasm && pnpm typecheck && pnpm --filter @rea/web build",
    "test:rust": "cargo test --workspace",
    "preview": "pnpm --filter @rea/web preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:wasm && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@rea/design": "workspace:*",
    "@tailwindcss/node": "4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
