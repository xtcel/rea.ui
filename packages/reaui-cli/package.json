{
  "name": "@xtcel/reaui-cli",
  "version": "0.1.3",
  "type": "module",
  "description": "Command-line interface for REA UI design documents: create, validate, pack, unpack and preview React TSX design sources. No browser, no runtime dependencies.",
  "license": "Apache-2.0",
  "author": "xtcel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtcel/rea.ui.git",
    "directory": "packages/reaui-cli"
  },
  "homepage": "https://github.com/xtcel/rea.ui/tree/main/packages/reaui-cli#readme",
  "bugs": {
    "url": "https://github.com/xtcel/rea.ui/issues"
  },
  "keywords": [
    "reaui",
    "react",
    "tsx",
    "tailwindcss",
    "design",
    "design-tool",
    "ui-design",
    "design-system",
    "figma",
    "ai",
    "ai-agent",
    "llm",
    "mcp",
    "codegen",
    "cli"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "reaui": "bin/reaui.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "exports": {
    ".": "./dist/reaui.mjs"
  },
  "scripts": {
    "reaui": "node ./bin/reaui.mjs",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@rea/design": "workspace:*",
    "@rea/document": "workspace:*",
    "@rea/renderer-dom": "workspace:*",
    "@rea/storage": "workspace:*",
    "@rea/tailwind": "workspace:*",
    "@babel/parser": "8.0.10",
    "@babel/types": "8.0.10",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
