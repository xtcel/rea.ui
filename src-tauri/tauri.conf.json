{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REA UI",
  "version": "../package.json",
  "identifier": "com.reaui.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "REA UI",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#ffffff",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "GraphicsAndDesign",
    "fileAssociations": [{
      "ext": ["reaui"],
      "name": "REA UI 文档",
      "role": "Editor",
      "rank": "Owner",
      "mimeType": "application/vnd.reaui+zip",
      "exportedType": { "identifier": "com.reaui.document", "conformsTo": ["public.data", "public.archive"] }
    }],
    "shortDescription": "React 单源设计编辑器",
    "longDescription": "REA UI 是以 React 页面为设计源的本地设计工作空间，支持画布编辑、图层管理和 .reaui 文档导入导出。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
